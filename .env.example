# ===== Model =====
ARK_API_KEY=your_dashscope_api_key
MODEL=qwen-plus
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDER=text-embedding-v1
GRADE_MODEL=qwen-plus
MAX_TOKENS=8192
TRUNCATE_STRATEGY=end

# ===== Database =====
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/agent_chat

# ===== Rerank (optional) =====
RERANK_MODEL=qwen3-rerank
RERANK_BINDING_HOST=https://dashscope.aliyuncs.com/compatible-mode/v1
RERANK_API_KEY=your_dashscope_api_key
RERANK_TOP_K=10

# ===== Milvus =====
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_SEARCH_TOP_K=20
MILVUS_VECTOR_DIM=1536

# ===== Tools (optional) =====
AMAP_WEATHER_API=https://restapi.amap.com/v3/weather/weatherInfo
AMAP_API_KEY=your_amap_key

# ===== Web Search (optional) =====
TAVILY_API_KEY=your_tavily_api_key

# ===== Neo4j =====
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ===== RRF 三通道权重 =====
RRF_WEIGHT_DENSE=0.4
RRF_WEIGHT_SPARSE=0.3
RRF_WEIGHT_GRAPH=0.3

# ===== v5.0 Observability =====
OTEL_ENABLED=true
JAEGER_HTTP_ENDPOINT=http://localhost:4318/v1/traces
METRICS_ENABLED=true
LOG_LEVEL=INFO
LOG_FORMAT=json

# ===== v5.0 High Availability =====
NEO4J_QUERY_TIMEOUT=1.5

# ===== 实体消歧 =====
ENTITY_SIM_THRESHOLD=0.75
